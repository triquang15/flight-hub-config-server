# FlightHub local development env.
# Shared local defaults for the team. Do not put real secrets here.

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_BIND_LOG_LEVEL=TRACE
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional per-service Kafka overrides.
# USER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# BOOKING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PAYMENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# FLIGHT_OPS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SEAT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Local PostgreSQL credentials.
FLIGHTHUB_DATASOURCE_USERNAME=postgres
FLIGHTHUB_DATASOURCE_PASSWORD=12345678

USER_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_user_db
AIRLINE_CORE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_core_db
FLIGHT_OPS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_flight_db
LOCATION_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_location_db
SEAT_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_seat_db
PRICING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_pricing_db
ANCILLARY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_ancillary_db
BOOKING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_booking_db
PAYMENT_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_payment_db
SUBSCRIPTION_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_subscription_db
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airline_notification_db

# Local external providers. Fill these only when testing the integrations.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
MAIL_USERNAME=flight.hub015@gmail.com
MAIL_APP_PASSWORD=fzyx iyfd krku awpz
MAIL_FROM=flight.hub015@gmail.com
TWILIO_ACCOUNT_SID=
